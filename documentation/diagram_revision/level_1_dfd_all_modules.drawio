alue="Referenced hazard record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_252" target="proc_239"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_256" value="Existing Barangay report and parent version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_253" target="proc_239"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_257" value="Draft or submitted Barangay report version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_243" target="store_253"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_258" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Incident and reporting period/as-of time&lt;br&gt;• included Purok report version IDs&lt;br&gt;• excluded/returned reports and reasons&lt;br&gt;• Barangay-level facts/source&lt;br&gt;• affected families/persons&lt;br&gt;• inside/outside EC displacement and EC count&lt;br&gt;• casualties&lt;br&gt;• totally/partially damaged houses&lt;br&gt;• infrastructure, agriculture, livelihood and lifeline effects&lt;br&gt;• response actions&lt;br&gt;• assistance/resources&lt;br&gt;• urgent needs/issues&lt;br&gt;• unresolved discrepancies&lt;br&gt;• evidence&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_259" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Include only verified Purok versions&lt;br&gt;• Prevent double-counting across Puroks&lt;br&gt;• Keep current and cumulative totals distinct&lt;br&gt;• Preserve unresolved discrepancies&lt;br&gt;• Submission creates an immutable Barangay version&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; NDRRMOC SOPG 2024 essential elements; DSWD MC 12 s.2026; RA 10121 §12.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_260" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_actor_10_1" value="Barangay User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="677" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_10_1" value="Barangay-level facts, source inclusion/exclusion reasons, and reconciliation data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_10_1" target="proc_239"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_10_2" value="Barangay User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1703" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_10_2" value="Barangay actions, assistance, resources, issues, needs, and evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_10_2" target="proc_242"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_10_3" value="Barangay User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2045" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_10_3" value="Barangay report submission confirmation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_10_3" target="proc_243"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
