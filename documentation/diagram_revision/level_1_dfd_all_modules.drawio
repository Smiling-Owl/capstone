dgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_279" target="proc_268"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_284" value="Referenced hazard record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_280" target="proc_268"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_285" value="Version-specific Barangay report verification decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_270" target="store_281"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_286" value="verified, returned, or rejected status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_271" target="store_281"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_287" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Barangay report/version&lt;br&gt;• as-of and submission times&lt;br&gt;• included source versions&lt;br&gt;• source/evidence summary&lt;br&gt;• population and displacement reconciliation&lt;br&gt;• casualties&lt;br&gt;• damage/loss and lifeline checks&lt;br&gt;• actions/assistance/needs&lt;br&gt;• unresolved discrepancy treatment&lt;br&gt;• decision&lt;br&gt;• correction/reconciliation reason&lt;br&gt;• verifier/time&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_288" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Do not alter the submitted version&lt;br&gt;• Reconciliation must cite sources&lt;br&gt;• Unknown values remain explicit&lt;br&gt;• Only verified Barangay versions become eligible for Process 12.0&lt;br&gt;• Corrections create linked versions&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; NDRRMOC SOPG 2024 source-supported progress/SitRep reporting; DSWD validation hierarchy.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_289" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="actorout_submitter_11" value="Barangay User (duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2340" y="420" width="210" heigh