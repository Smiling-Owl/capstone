1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_186" target="proc_187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_193" value="Preliminary population, displacement, casualty, and vulnerability package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_187" target="proc_188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_194" value="Preliminary damage and lifeline-disruption package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_188" target="proc_189"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_195" value="Response, needs, and evidence package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_189" target="proc_190"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_196" value="Incident type, Purok, exact location/geometry, occurrence, discovery, report, and as-of times" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_183" target="proc_185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_197" value="Purok report validation and submission status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_190" target="actorout_184"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_198" value="&lt;div style='font-size:14px;font-weight:600'&gt;Hazards DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="store_199" value="&lt;div style='font-size:14px;font-weight:600'&gt;Purok Incident DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1370" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_200" value="Referenced hazard record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_198" target="proc_185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_201" value="Existing incident and parent version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_199" target="proc_185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_202" value="Draft or submitted Purok report version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_190" target="store_199"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_203" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Report ID/version/status&lt;br&gt;• incident/hazard type and name&lt;br&gt;• occurrence/discovery/as-of/submission times&lt;br&gt;• Purok, Barangay, exact site and GPS when available&lt;br&gt;• what-where-when-why-how overview&lt;br&gt;• source/reporter and observation time&lt;br&gt;• affected families/persons&lt;br&gt;• dead, injured/ill and missing&lt;br&gt;• inside/outside evacuation-center displacement&lt;br&gt;• evacuation-center name/location&lt;br&gt;• totally/partially damaged houses&lt;br&gt;• roads, facilities, water, power and communications&lt;br&gt;• immediate actions&lt;br&gt;• urgent needs&lt;br&gt;• photos/documents and provenance&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_204" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Submit rapidly even when incomplete&lt;br&gt;• Allow estimated, partially verified, confirmed, unknown, no report, and not assessed&lt;br&gt;• Do not fabricate zeroes&lt;br&gt;• Timestamp and preserve every version&lt;br&gt;• Person-level sensitive information remains restricted&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; NDRRMOC SOPG 2024 pp. xxiv,51-53; DSWD MC 12 s.2026 Annex F; RA 10821 §9; RA 10173.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_205" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_actor_8_1" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="677" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_8_1" value="Situation narrative, chronology, continuing threat, source identity, and confidence data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_8_1" target="proc_186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_8_2" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1019" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_8_2" value="Affected, displaced, evacuation, casualty, and vulnerable-group estimates with value states" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_8_2" target="proc_187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_8_3" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1361" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_8_3" value="Housing, infrastructure, facility, livelihood, environmental, and lifeline damage data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_8_3" target="proc_188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_8_4" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1703" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_8_4" value="Actions, assistance, resources, urgent needs, issues, attachments, and provenance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_8_4" target="proc_189"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_8_5" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2045" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_8_5" value="Purok report submission confirmation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_8_5" target="proc_190"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
