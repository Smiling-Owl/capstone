='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Attach Source Evidence&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1593" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="proc_114" value="&lt;div style='text-align:left;font-size:15px;font-weight:700;padding:3px 8px 5px'&gt;5.5&lt;/div&gt;&lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Validate and Save Hazard Record&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2020" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="flow_115" value="Hazard classification package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_110" target="proc_111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_116" value="Hazard location and characteristics package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_111" target="proc_112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_117" value="Hazard occurrence, severity, status, and confidence package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_112" target="proc_113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_118" value="Source evidence and provenance package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_113" target="proc_114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_119" value="Purok hazard type/name, location, occurrence/assessment time, severity/status, source, and evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_104" target="proc_110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_120" value="Barangay hazard type/name, location, occurrence/assessment time, severity/status, source, and evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_106" target="proc_110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_121" value="City hazard type/name, location, occurrence/assessment time, severity/status, source, and evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_108" target="proc_110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_122" value="hazard record status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_114" target="actorout_105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_123" value="hazard record status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_114" target="actorout_107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_124" value="hazard details and record status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_114" target="actorout_109"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_125" value="&lt;div style='font-size:14px;font-weight:600'&gt;Hazards DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_126" value="Existing hazard record and version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_125" target="proc_111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_127" value="Versioned hazard record and source evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_114" target="store_125"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_128" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Hazard name/type&lt;br&gt;• originating level and jurisdiction&lt;br&gt;• location/address/landmark&lt;br&gt;• GPS point, line or polygon when available&lt;br&gt;• occurrence/onset date and time&lt;br&gt;• observed or forecast&lt;br&gt;• intensity/severity and measurement unit&lt;br&gt;• frequency/probability where applicable&lt;br&gt;• affected/exposed area&lt;br&gt;• present status and continuing threat&lt;br&gt;• source agency/person&lt;br&gt;• attachments and capture time&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_129" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Use hazard-specific measurements where available&lt;br&gt;• Cause may be unknown or under investigation&lt;br&gt;• Separate baseline hazard inventory from an active incident&lt;br&gt;• Record author and version&lt;br&gt;• Higher-level or maker-checker verification must occur before authoritative use&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 10121 §§3,9,12; NDRRMOC SOPG 2024 essential information.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_130" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram>
