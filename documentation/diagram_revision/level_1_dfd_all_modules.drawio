border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Assign System Roles and Permissions&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1336" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="proc_424" value="&lt;div style='text-align:left;font-size:15px;font-weight:700;padding:3px 8px 5px'&gt;17.5&lt;/div&gt;&lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Record Administrative Change&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1678" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="proc_425" value="&lt;div style='text-align:left;font-size:15px;font-weight:700;padding:3px 8px 5px'&gt;17.6&lt;/div&gt;&lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Return Account Result&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2020" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="flow_426" value="System-account search criteria" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_420" target="proc_421"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_427" value="Selected administrator account details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;stroke