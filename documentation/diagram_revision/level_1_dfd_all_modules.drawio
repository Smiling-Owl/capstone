rget="proc_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_21" value="Assigned Purok account details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_16" target="proc_17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_22" value="Purok identity, contact, assignment, username, account action, and reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_11" target="proc_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_23" value="Purok account status, validation findings, and temporary credential instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_17" target="actorout_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_24" value="&lt;div style='font-size:14px;font-weight:600'&gt;Accounts DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_25" value="Purok account record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_15" target="store_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_26" value="Existing Purok account and assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_24" target="proc_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_27" value="Role and Purok jurisdiction assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_16" target="store_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_28" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Full name&lt;br&gt;• official role/designation&lt;br&gt;• mobile number or email&lt;br&gt;• Barangay and Purok assignment&lt;br&gt;• username&lt;br&gt;• temporary credential delivery channel&lt;br&gt;• account status&lt;br&gt;• reason for activation, suspension, reset, or update&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_29" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• No self-registration&lt;br&gt;• Barangay creates only accounts inside its jurisdiction&lt;br&gt;• Duplicate identity/contact check&lt;br&gt;• Temporary credentials must be changed&lt;br&gt;• Every administrative change is attributable and timestamped&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; System-control design; RA 10173 data minimization and security.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_30" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_1_errors" value="Identity, duplicate, or jurisdiction validation findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_14" target="proc_17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_1_roles" value="Permitted role and jurisdiction record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="store_24" target="proc_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_1_credential_meta" value="Credential and account-status metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_17" target="store_24"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
