;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Record Verification Decision&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1593" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="proc_140" value="&lt;div style='text-align:left;font-size:15px;font-weight:700;padding:3px 8px 5px'&gt;6.5&lt;/div&gt;&lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Return Correction or Release Verified Profile&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2020" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="flow_141" value="Selected Purok profile version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_136" target="proc_137"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_142" value="Required-section completeness findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_137" target="proc_138"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_143" value="Evidence, boundary, population, exposure, facility, and hazard-consistency findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_138" target="proc_139"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_144" value="Verification outcome and correction requirements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_139" target="proc_140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_145" value="Purok profile query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_134" target="proc_136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_146" value="Purok profile details and verification status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_140" target="actorout_135"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_147" value="Verified Purok profile dataset for Barangay profiling" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_140" target="actorout_135"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_148" value="&lt;div style='font-size:14px;font-weight:600'&gt;Purok Profile DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_149" value="submitted Purok profile version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_148" target="proc_136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_150" value="Version-specific Purok profile verification decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_139" target="store_148"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_151" value="verified, returned, or rejected status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_140" target="store_148"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_152" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Profile/version ID&lt;br&gt;• reviewed Purok and period&lt;br&gt;• required-section checklist&lt;br&gt;• source/evidence checklist&lt;br&gt;• boundary and duplicate checks&lt;br&gt;• population-total reconciliation&lt;br&gt;• hazard/exposure consistency&lt;br&gt;• facility/lifeline validation&lt;br&gt;• decision: verify, return, reject&lt;br&gt;• correction items&lt;br&gt;• reason and reviewer timestamp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_153" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Reviewer cannot silently edit submitted facts&lt;br&gt;• Correction creates a new linked version&lt;br&gt;• Decision identifies the exact reviewed version&lt;br&gt;• Only verified data is released to Process 4.0&lt;br&gt;• Unresolved limitations remain visible&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 10121 local consolidation duties; DHSUD CDRA evidence structure; project verification requirements.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_154" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="actorout_submitter_6" value="Purok User (duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2340" y="420" width="210" height="90" as="geometry"/></mxCell><mxCell id="submitter_status_6" value="Purok profile status and correction request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_140" target="actorout_submitter_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_6_1" value="Barangay User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1618" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_6_1" value="Purok profile review decision, reason, correction items, reviewer, and timestamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_6_1" target="proc_139"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
