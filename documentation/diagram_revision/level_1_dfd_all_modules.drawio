FF;" edge="1" parent="1" source="actorin_387" target="proc_391"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_404" value="DRRM administrator identifier and password" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_389" target="proc_391"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_405" value="Purok user access page or authentication error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_396" target="actorout_386"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_406" value="Barangay user access page or authentication error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_396" target="actorout_388"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_407" value="DRRM administrator access page or authentication error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_396" target="actorout_390"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_408" value="&lt;div style='font-size:14px;font-weight:600'&gt;Accounts DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_409" value="Validated account identifier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_393" target="store_408"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_410" value="Account record, credential metadata, role, and jurisdiction assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_408" target="proc_393"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_411" value="Login and audit metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_396" target="store_408"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_412" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Username/email or assigned identifier&lt;br&gt;• password&lt;br&gt;• optional second factor when configured&lt;br&gt;• device/session metadata collected by policy&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_413" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Generic error messages prevent account enumeration&lt;br&gt;• Passwords are compared as secure hashes and never returned&lt;br&gt;• Inactive/suspended/locked accounts cannot authenticate&lt;br&gt;• Role and jurisdiction are determined from stored assignments&lt;br&gt;• Apply attempt throttling and secure session expiry&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; System security design; RA 10173 security principle.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_414" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_16_field_error" value="Credential-field validation error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_392" target="proc_396"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_16_auth_error" value="Authentication failure or inactive-account result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_394" target="proc_396"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="level1_17" name="17.0 System User Management"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_415" value="Level 1 DFD — 17.0 System User Management" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=25;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="2540" height="42" as="geometry"/></mxCell><mxCell id="subtitle_416" value="Decomposition of parent process 17.0 · Gane–Sarson notation · subprocess names are user-facing verb phrases" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="2540" height="28" as="geometry"/></mxCell><mxCell id="balance_417" value="BALANCED PARENT BOUNDARY  |  Inputs: System-account search criteria and authorized administrator context  |  Outputs: Administrator account details, account status, and administrative result" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7C93A8;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="112" width="2490" height="72" as="geometry"/></mxCell><mxCell id="actorin_418" value="DRRM Administrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#8A5A00;strokeWidth=2;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="300" width="225" height="75" as="geometry"/></mxCell><mxCell id="actorout_419" value="DRRM Administrator
