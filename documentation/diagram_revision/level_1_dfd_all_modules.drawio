72A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_162" target="proc_163"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_168" value="Verification outcome and correction requirements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_163" target="proc_164"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_169" value="Barangay profile query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_158" target="proc_160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_170" value="Barangay profile details and verification status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_164" target="actorout_159"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_171" value="&lt;div style='font-size:14px;font-weight:600'&gt;Purok Profile DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="store_172" value="&lt;div style='font-size:14px;font-weight:600'&gt;Barangay Profile DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1370" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_173" value="submitted Barangay profile version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_172" target="proc_160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_174" value="Verified Purok profile source versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_171" target="proc_161"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_175" value="Version-specific Barangay profile verification decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_163" target="store_172"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_176" value="verified, returned, or rejected status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_164" target="store_172"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_177" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Barangay profile/version&lt;br&gt;• included Purok versions and coverage&lt;br&gt;• missing Puroks and justification&lt;br&gt;• population and facility reconciliation&lt;br&gt;• aggregation method&lt;br&gt;• hazard, vulnerability, capacity and map evidence&lt;br&gt;• decision&lt;br&gt;• correction/discrepancy list&lt;br&gt;• reason&lt;br&gt;• verifier and timestamp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_178" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Verify included source-version IDs&lt;br&gt;• Check double-counting and geographic coverage&lt;br&gt;• Verifier does not overwrite the submission&lt;br&gt;• Corrections create a new version&lt;br&gt;• A verified profile remains traceable to Purok sources&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 10121 §12 local-risk consolidation; DHSUD CDRA guidance.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_179" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="actorout_submitter_7" value="Barangay User (duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2340" y="420" width="210" height="90" as="geometry"/></mxCell><mxCell id="submitter_status_7" value="Barangay profile status and correction request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_164" target="actorout_submitter_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_7_1" value="DRRM Administrator&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1618" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_7_1" value="Barangay profile verification decision, reason, correction items, verifier, and timestamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_7_1" target="proc_163"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
