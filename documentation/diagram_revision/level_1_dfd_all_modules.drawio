ource="proc_38" target="proc_39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_44" value="Assigned Barangay account details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_39" target="proc_40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_45" value="Barangay identity, contact, assignment, username, account action, and reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_34" target="proc_36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_46" value="Barangay account status, validation findings, and temporary credential instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_40" target="actorout_35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_47" value="&lt;div style='font-size:14px;font-weight:600'&gt;Accounts DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_48" value="Barangay account record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_38" target="store_47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_49" value="Existing Barangay account and assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_47" target="proc_37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_50" value="Role and Barangay jurisdiction assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_39" target="store_47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_51" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Full name&lt;br&gt;• official position&lt;br&gt;• Barangay&lt;br&gt;• mobile number or email&lt;br&gt;• username&lt;br&gt;• assigned role&lt;br&gt;• jurisdiction&lt;br&gt;• account state&lt;br&gt;• temporary credential channel&lt;br&gt;• change reason&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_52" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• No public registration&lt;br&gt;• DRRM Administrator creates Barangay accounts&lt;br&gt;• Jurisdiction and least-privilege checks&lt;br&gt;• Credential reset does not disclose an existing password&lt;br&gt;• Changes remain auditable&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; System-control design; RA 10173 data minimization and security.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_53" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_2_errors" value="Identity, duplicate, or jurisdiction validation findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_37" target="proc_40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_2_roles" value="Permitted role and jurisdiction record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="store_47" target="proc_39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_2_credential_meta" value="Credential and account-status metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_40" target="store_47"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
