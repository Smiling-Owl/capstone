acingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="store_94" value="&lt;div style='font-size:14px;font-weight:600'&gt;Barangay Profile DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1370" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_95" value="Verified Purok profile versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_93" target="proc_81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_96" value="existing Barangay profile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_94" target="proc_82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_97" value="draft or submitted Barangay profile version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_85" target="store_94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_98" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Barangay identity/boundary and profile period&lt;br&gt;• included verified Purok versions&lt;br&gt;• Barangay population totals and reconciliation notes&lt;br&gt;• cross-Purok hazard exposure and risk maps&lt;br&gt;• Barangay facilities and lifelines&lt;br&gt;• evacuation centers and capacities&lt;br&gt;• responders, equipment, supplies and partnerships&lt;br&gt;• vulnerability and adaptive/coping capacity&lt;br&gt;• aggregation method&lt;br&gt;• unresolved gaps&lt;br&gt;• source and as-of date&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_99" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Only verified Purok versions enter consolidation&lt;br&gt;• Preserve included source-version IDs&lt;br&gt;• Do not double-count households or facilities&lt;br&gt;• Record Barangay-only additions separately&lt;br&gt;• DRRM verification is performed in Process 7.0&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 10121 §12(c)(3),(8)-(12); DHSUD CDRA guidance.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_100" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df