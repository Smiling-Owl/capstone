rokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_216" target="actorout_210"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_224" value="&lt;div style='font-size:14px;font-weight:600'&gt;Purok Incident DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="store_225" value="&lt;div style='font-size:14px;font-weight:600'&gt;Hazards DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1370" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_226" value="Submitted immutable Purok report version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_224" target="proc_211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_227" value="Referenced hazard record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_225" target="proc_213"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_228" value="Version-specific Purok report review decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_215" target="store_224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_229" value="verified, returned, or rejected status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_216" target="store_224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_230" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Report/version ID&lt;br&gt;• receipt and as-of times&lt;br&gt;• required-field checklist&lt;br&gt;• estimated versus confirmed flags&lt;br&gt;• source and evidence checks&lt;br&gt;• population/displacement reconciliation&lt;br&gt;• casualty and damaged-house validation&lt;br&gt;• duplicate incident/report check&lt;br&gt;• lifeline/action/needs review&lt;br&gt;• decision&lt;br&gt;• correction list and reason&lt;br&gt;• reviewer/time&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_231" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Verify the submitted version, not a mutable record&lt;br&gt;• Reviewer cannot rewrite source data&lt;br&gt;• Return clear field-specific corrections&lt;br&gt;• Preserve prior versions&lt;br&gt;• Only verified Purok versions enter Process 10.0&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; NDRRMOC progressive reporting and source checking; DSWD DROMIC validation flow.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_232" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="actorout_submitter_9" value="Purok User (duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2340" y="420" width="210" height="90" as="geometry"/></mxCell><mxCell id="submitter_status_9" value="Purok report status and correction request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_216" target="actorout_submitter_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_9_1" value="Barangay User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1703" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_9_1" value="Purok report review decision, reason, affected fields, reviewer, and timestamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_9_1" target="proc_215"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
