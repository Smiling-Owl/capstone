labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_335" target="proc_326"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_337" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Incident/report ID&lt;br&gt;• hazard type&lt;br&gt;• date or as-of range&lt;br&gt;• Purok/location&lt;br&gt;• status&lt;br&gt;• version&lt;br&gt;• submitted/verified date&lt;br&gt;• keyword&lt;br&gt;• sort and page&lt;br&gt;• requested export format&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_338" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Enforce the authenticated Purok jurisdiction&lt;br&gt;• Show version and verification status&lt;br&gt;• Do not expose restricted person-level data in ordinary export&lt;br&gt;• History is read-only&lt;br&gt;• Log sensitive access/export events&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 9470 public-record principles; RA 10173 access limitation; system traceability requirement.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_339" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram>
