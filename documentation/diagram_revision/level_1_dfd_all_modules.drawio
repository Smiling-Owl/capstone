lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Record Hazard Exposure and Capacity&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1593" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="proc_63" value="&lt;div style='text-align:left;font-size:15px;font-weight:700;padding:3px 8px 5px'&gt;3.5&lt;/div&gt;&lt;div style='border-top:2px solid #1C557E;padding:13px 8px 4px;text-align:center;font-size:17px;font-weight:600;line-height:1.2'&gt;Validate and Submit Purok Profile&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2020" y="390" width="275" height="118" as="geometry"/></mxCell><mxCell id="flow_64" value="Purok identity and profile metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_59" target="proc_60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_65" value="Population and vulnerability dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_60" target="proc_61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_66" value="Housing, facility, lifeline, and population exposure inventory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_61" target="proc_62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow_67" value="Complete Purok CDRA profile package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_62" target="proc_63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input_68" value="Purok identification, boundary, profile period, and source details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actorin_57" target="proc_59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="output_69" value="Purok profile status and validation findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_63" target="actorout_58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="store_70" value="&lt;div style='font-size:14px;font-weight:600'&gt;Purok Profile DB&lt;/div&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="74" as="geometry"/></mxCell><mxCell id="storeflow_71" value="existing Purok profile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="store_70" target="proc_59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="storeflow_72" value="draft or submitted Purok profile version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#244B68;strokeWidth=2;fontSize=13;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;strokeColor=#475569;" edge="1" parent="1" source="proc_63" target="store_70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fields_73" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data-flow dictionary (field groups)&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Purok name/code and boundary&lt;br&gt;• profile period and as-of date&lt;br&gt;• households and population&lt;br&gt;• sex/age groups&lt;br&gt;• PWDs, older persons, pregnant/lactating women and other special needs&lt;br&gt;• housing/material and tenure indicators&lt;br&gt;• critical facilities&lt;br&gt;• roads, water, power and communications&lt;br&gt;• hazard type, location, frequency/intensity&lt;br&gt;• exposed people/assets&lt;br&gt;• local equipment, responders, evacuation sites and coping capacity&lt;br&gt;• map/source/evidence&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="rules_74" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Validation, controls, and outputs&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5'&gt;• Use CDRA baseline data—not current incident impacts&lt;br&gt;• Allow unknown/not assessed with reason&lt;br&gt;• Record source and observation period&lt;br&gt;• Submitted profile versions are not overwritten&lt;br&gt;• Barangay verification is performed in Process 6.0&lt;br&gt;&lt;br&gt;&lt;b&gt;Basis:&lt;/b&gt; RA 10121 §12(c)(3),(9),(12); DHSUD CDRA guidance; RA 10821 §9.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="755" width="1220" height="500" as="geometry"/></mxCell><mxCell id="note_75" value="Duplicate entity symbols represent the same Level 0 external entity. External entities never connect directly to a data store. Submitted and verified records are versioned rather than silently overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="2000" height="55" as="geometry"/></mxCell><mxCell id="df_actor_3_1" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="763" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_3_1" value="Household, population, sex-age, vulnerable-group, and special-needs data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="df_actor_3_1" target="proc_60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="df_actor_3_2" value="Purok User&lt;br&gt;(duplicate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B68D2C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="205" width="225" height="70" as="geometry"/></mxCell><mxCell id="df_input_3_2" value="Housing, critical-facility, road, water, power, and communications data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;labelBackgroundColor=#FFFFFF;