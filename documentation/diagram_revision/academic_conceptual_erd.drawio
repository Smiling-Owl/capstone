<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="Codex" version="26.0.16" type="device"><diagram id="academic_erd_0" name="00 — Academic ERD Notation and Scope"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="2500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="text_2" value="&lt;div style=&quot;font-family:Arial;font-size:36px;font-weight:700;color:#16324F;text-align:center&quot;&gt;00 — Academic ERD Notation and Scope&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="4080" height="55" as="geometry"/></mxCell><mxCell id="text_3" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#475569;text-align:center&quot;&gt;Conceptual EER model · no foreign-key attributes · underlined identifiers · 24-point minimum text · 5-point outlines&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="4080" height="80" as="geometry"/></mxCell><mxCell id="entity_4" value="&lt;div style=&quot;background:#1C557E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;RegularEntity&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Entity_identifier&lt;/u&gt;&lt;br&gt;Descriptive_attribute&lt;br&gt;Status_attribute&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=0;fillColor=#FFFFFF;strokeColor=#1C557E;" vertex="1" parent="1"><mxGeometry x="150" y="260" width="800" height="222" as="geometry"/></mxCell><mxCell id="entity_5" value="&lt;div style=&quot;background:#1C557E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;WeakEntity&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Partial_identifier&lt;/u&gt;&lt;br&gt;Existence-dependent_attribute&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;double=1;fillColor=#FFFFFF;strokeColor=#1C557E;rounded=0;" vertex="1" parent="1"><mxGeometry x="1150" y="260" width="800" height="220" as="geometry"/></mxCell><mxCell id="entity_6" value="&lt;div style=&quot;background:#0F766E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;AssociativeEntity&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Association_identifier&lt;/u&gt;&lt;br&gt;Relationship_attribute&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=1;arcSize=12;fillColor=#F0FDFA;strokeColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="2150" y="260" width="800" height="220" as="geometry"/></mxCell><mxCell id="entity_7" value="&lt;div style=&quot;background:#8A5A00;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;SubtypeEntity&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Inherited_identifier&lt;/u&gt;&lt;br&gt;Subtype_specific_attribute&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=0;fillColor=#FFF8E7;strokeColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="3150" y="260" width="800" height="220" as="geometry"/></mxCell><mxCell id="text_8" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Regular entity&lt;/b&gt;&lt;br&gt;Exists independently and has its own identifier.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="800" width="800" height="180" as="geometry"/></mxCell><mxCell id="text_9" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Weak entity&lt;/b&gt;&lt;br&gt;Its underlined partial identifier is completed by the owning entity through an identifying relationship.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1150" y="800" width="800" height="220" as="geometry"/></mxCell><mxCell id="text_10" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Associative entity&lt;/b&gt;&lt;br&gt;Resolves a many-to-many relationship and retains relationship-specific facts.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2150" y="800" width="800" height="220" as="geometry"/></mxCell><mxCell id="text_11" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Subtype entity&lt;/b&gt;&lt;br&gt;Inherits the identifier and common attributes of its supertype.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3150" y="800" width="800" height="220" as="geometry"/></mxCell><mxCell id="text_12" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Specialization marker:&lt;/b&gt; “d” means disjoint. The Account, CDRA Profile, Incident Report, Report Effect Item, and DRRM SitRep Content Item specializations are total and disjoint.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="1200" width="1700" height="260" as="geometry"/></mxCell><mxCell id="text_13" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Foreign keys:&lt;/b&gt; intentionally absent from the entity compartments. The relationship lines communicate association and cardinality at this academic stage.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2250" y="1200" width="1700" height="220" as="geometry"/></mxCell><mxCell id="text_14" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Excluded as non-entities:&lt;/b&gt; Login, Registration, Dashboard, verification queues, history catalogs, report previews, form screens, and DFD database labels. These are processes, interfaces, views, or subject-area stores.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="1600" width="1700" height="420" as="geometry"/></mxCell><mxCell id="text_15" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#16324F;text-align:left&quot;&gt;&lt;b&gt;Evidence boundary:&lt;/b&gt; RA 10121, DHSUD CDRA guidance, NDRRMOC SOPG 2024, and DROMIC determine information categories. Monthly profiling and the Purok → Barangay → DRRM workflow are approved project rules, not literal statutory database prescriptions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsibility boundary:&lt;/b&gt; Purok reports affected-population totals; Barangay consolidates population, casualty, and damage effects; DRRM owns the remaining Situation Report content.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2250" y="1600" width="1700" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="academic_erd_1" name="01 — Accounts, Jurisdictions, Sources, and Audit"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5000" pageHeight="3600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="text_16" value="&lt;div style=&quot;font-family:Arial;font-size:36px;font-weight:700;color:#16324F;text-align:center&quot;&gt;01 — Accounts, Jurisdictions, Sources, and Audit&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="4880" height="55" as="geometry"/></mxCell><mxCell id="text_17" value="&lt;div style=&quot;font-family:Arial;font-size:24px;color:#475569;text-align:center&quot;&gt;Account subtypes express administrative level; role assignments express duties and scope&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="4880" height="80" as="geometry"/></mxCell><mxCell id="entity_18" value="&lt;div style=&quot;background:#1C557E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;OrganizationUnit&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Organization_unit_id&lt;/u&gt;&lt;br&gt;Organization_unit_code&lt;br&gt;Organization_unit_type&lt;br&gt;Organization_unit_name&lt;br&gt;Geographic_code&lt;br&gt;Location_description&lt;br&gt;Boundary_reference&lt;br&gt;Organization_unit_status&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=0;fillColor=#FFFFFF;strokeColor=#1C557E;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="720" height="417" as="geometry"/></mxCell><mxCell id="entity_19" value="&lt;div style=&quot;background:#16324F;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;Account&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Account_id&lt;/u&gt;&lt;br&gt;Authentication_identifier&lt;br&gt;Username&lt;br&gt;First_name&lt;br&gt;Middle_name&lt;br&gt;Last_name&lt;br&gt;Personnel_identifier&lt;br&gt;Designation&lt;br&gt;Official_email&lt;br&gt;Official_mobile&lt;br&gt;Authority_reference&lt;br&gt;Account_status&lt;br&gt;Created_at&lt;br&gt;Deactivated_at&lt;br&gt;Deactivation_reason&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=0;fillColor=#FFFFFF;strokeColor=#1C557E;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="720" height="690" as="geometry"/></mxCell><mxCell id="entity_20" value="&lt;div style=&quot;background:#1C557E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;Role&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:24px;line-height:1.45;padding:16px 20px&quot;&gt;&lt;u&gt;Role_id&lt;/u&gt;&lt;br&gt;Role_code&lt;br&gt;Role_name&lt;br&gt;Role_description&lt;br&gt;Role_status&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeWidth=5;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;shape=rectangle;rounded=0;fillColor=#FFFFFF;strokeColor=#1C557E;" vertex="1" parent="1"><mxGeometry x="2140" y="240" width="720" height="300" as="geometry"/></mxCell><mxCell id="entity_21" value="&lt;div style=&quot;background:#1C557E;color:white;font-family:Arial;font-size:28px;font-weight:700;padding:15px 18px;text-align:center&quot;&gt;InformationSource&lt;/div&gt;&lt;div style=&quot;font-fami