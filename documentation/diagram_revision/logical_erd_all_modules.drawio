<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="erd_index" name="ERD Index, Legend, and Scope"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_5" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#16324F&quot;&gt;ERD Index, Legend, and Scope&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2540" height="45" as="geometry"/></mxCell><mxCell id="s_6" value="Logical relational ERD · Crow’s-foot cardinalities · UUID primary keys · immutable submitted versions" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="2540" height="28" as="geometry"/></mxCell><mxCell id="n_1" value="&lt;div style='font-size:21px;font-weight:700;color:#16324F'&gt;Workbook pages&lt;/div&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Core ERD Overview&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Identity and Jurisdiction&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; CDRA Profiles and Verification&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Hazards, Sources, and Evidence&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Incident Reports and Verification&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Situation Reports, Approval, and Exports&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Integrity Rules and Data-Store Mapping" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1C557E;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="760" height="590" as="geometry"/></mxCell><mxCell id="n_2" value="&lt;div style='font-size:21px;font-weight:700;color:#16324F'&gt;Crow’s-foot legend&lt;/div&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = primary key&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = foreign key&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; = unique constraint&lt;br&gt;&lt;b&gt;1 — &amp;lt;&lt;/b&gt; = one-to-many&lt;br&gt;&lt;b&gt;1 — 1&lt;/b&gt; = one-to-one&lt;br&gt;&lt;b&gt;1 — 0..1&lt;/b&gt; = optional one&lt;br&gt;&lt;br&gt;Relationship labels describe the parent-to-child role." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#B68D2C;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="700" height="590" as="geometry"/></mxCell><mxCell id="n_3" value="&lt;div style='font-size:21px;font-weight:700;color:#16324F'&gt;Scope decisions&lt;/div&gt;&lt;br&gt;• Purok and Barangay remain explicit subtypes and application modules.&lt;br&gt;• Submitted, reviewed, verified, approved, and released versions are immutable.&lt;br&gt;• Corrections create a parent-linked version.&lt;br&gt;• Verification findings and decisions are stored separately from reported facts.&lt;br&gt;• Historical catalogs query versions, decisions, releases, and exports; they are not separate tables.&lt;br&gt;• Dashboard values are views/queries, not duplicated records.&lt;br&gt;• Personally identifiable casualty or household records are intentionally excluded until formally authorized." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#2F855A;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="140" width="820" height="590" as="geometry"/></mxCell><mxCell id="n_4" value="&lt;div style='font-size:18px;font-weight:700;color:#16324F'&gt;Mandate-aligned subject areas&lt;/div&gt;&lt;br&gt;&lt;b&gt;CDRA baseline:&lt;/b&gt; population, vulnerable groups, housing, exposed assets, critical facilities, lifelines, hazard assessment, capacity/resources, maps and evidence.&lt;br&gt;&lt;br&gt;&lt;b&gt;Incident reporting:&lt;/b&gt; chronology, affected/displaced population, casualties, damage, service disruption, actions, assistance, needs, evidence and value states.&lt;br&gt;&lt;br&gt;&lt;b&gt;Situation Reports:&lt;/b&gt; fixed as-of source snapshot, narrative sections, review/approval, release and preserved exports.&lt;br&gt;&lt;br&gt;&lt;b&gt;Important:&lt;/b&gt; mandates define required information and accountability; this exact relational schema is a system-design decision." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="810" width="2440" height="480" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd_overview" name="Core ERD Overview"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_45" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#16324F&quot;&gt;Core ERD Overview&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2940" height="45" as="geometry"/></mxCell><mxCell id="s_46" value="Logical relational ERD · Crow’s-foot cardinalities · UUID primary keys · immutable submitted versions" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="2940" height="28" as="geometry"/></mxCell><mxCell id="e_7" value="&lt;div style=&quot;background:#1C557E;color:white;font-size:16px;font-weight:700;padding:9px 10px&quot;&gt;AdministrativeUnit&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.55;padding:8px 10px&quot;&gt;&lt;b&gt;PK&lt;/b&gt; unit_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; parent_unit_id : UUID?&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; unit_code : VARCHAR&lt;br&gt;unit_type : ENUM&lt;br&