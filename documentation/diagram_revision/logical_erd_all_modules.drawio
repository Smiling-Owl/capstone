rity, access rules, retention rules, and privacy-impact assessment." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#2F855A;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2640" y="2070" width="1200" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd_sitrep" name="Situation Reports, Approval, and Exports"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_206" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#16324F&quot;&gt;Situation Reports, Approval, and Exports&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="3340" height="45" as="geometry"/></mxCell><mxCell id="s_207" value="Logical relational ERD · Crow’s-foot cardinalities · UUID primary keys · immutable submitted versions" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="3340" height="28" as="geometry"/></mxCell><mxCell id="e_183" value="&lt;div style=&quot;background:#1C557E;color:white;font-size:16px;font-weight:700;padding:9px 10px&quot;&gt;SituationReport&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.55;padding:8px 10px&quot;&gt;&lt;b&gt;PK&lt;/b&gt; situation_report_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; incident_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; jurisdiction_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; created_by_user_id : UUID&lt;br&gt;report_number : VARCHAR&lt;br&gt;report_type : ENUM&lt;br&gt;title : VARCHAR&lt;br&gt;created_at : TIMESTAMP&lt;br&gt;archived_at : TIMESTAMP?&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; jurisdiction + report_number&lt;/div&gt;" style="r