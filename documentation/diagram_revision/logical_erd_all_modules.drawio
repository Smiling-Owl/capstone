420" height="184" as="geometry"/></mxCell><mxCell id="e_191" value="&lt;div style=&quot;background:#1C557E;color:white;font-size:16px;font-weight:700;padding:9px 10px&quot;&gt;SituationReportExport&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.55;padding:8px 10px&quot;&gt;&lt;b&gt;PK&lt;/b&gt; export_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; sitrep_version_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; release_id : UUID?&lt;br&gt;format : PDF | XLSX | CSV&lt;br&gt;artifact_kind : ENUM&lt;br&gt;storage_key : VARCHAR&lt;br&gt;file_name : VARCHAR&lt;br&gt;mime_type : VARCHAR&lt;br&gt;file_size_bytes : BIGINT&lt;br&gt;checksum : VARCHAR&lt;br&gt;is_watermarked : BOOLEAN&lt;br&gt;generated_by_user_id : UUID&lt;br&gt;generated_at : TIMESTAMP&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590" y="850" width="450" height="331" as="geometry"/></mxCell><mxCell id="e_192" value="&lt;div style=&quot;background:#1C557E;color:white;font-size:16px;font-weight:700;padding:9px 10px&quot;&gt;AuditEvent&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.55;padding:8px 10px&quot;&gt;&lt;b&gt;PK&lt;/b&gt; audit_event_id : UUID&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; actor_user_id : UUID&lt;br&gt;action_code : VARCHAR&lt;br&gt;entity_type : VARCHAR&lt;br&gt;entity_id : UUID&lt;br&gt;occurred_at : TIMESTAMP&lt;br&gt;request_id : VARCHAR?&lt;br&gt;prior_state_hash : VARCHAR?&lt;br&gt;new_state_hash : VARCHAR?&lt;br&gt;metadata_json : JSON?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C557E;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2120" y="850" width="430" height="268" as="geometry"/></mxCell><mxCell id="r_193" value="immutable versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_183" target="e_184"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_194" value="authored sections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_195" value="frozen source set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_196" value="Barangay version entries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_186" target="e_187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_197" value="hazard version entries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_186" target="e_188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_198" value="review / approval attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_189"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_199" value="official release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_190"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_200" value="generated artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_191"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_201" value="released artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_190" target="e_191"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_202" value="lifecycle audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e_184" target="e_192"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_203" value="&lt;b&gt;Historical catalog:&lt;/b&gt; query SituationReportVersion, Decision, Release, Export, and SourceSnapshot. Return the stored released artifact; do not silently regenerate an historical official report." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1C557E;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="1500" width="1010" height="250" as="geometry"/></mxCell><mxCell id="n_204" value="&lt;b&gt;Snapshot rule:&lt;/b&gt; every reviewable SitRep version freezes exact verified Barangay report versions and hazard versions at one cut-off. Missing, stale, excluded, or conflicting sources are disclosed in the snapshot." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#B68D2C;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="1500" width="1010" height="250" as="geometry"/></mxCell><mxCell id="n_205" value="&lt;b&gt;Approval rule:&lt;/b&gt; repeated review/return/approval attempts are separate SituationReportDecision rows. An approved/released record is never overwritten; corrections create a new version and release." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#2F855A;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2300" y="1500" width="1010" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd_rules" name="Integrity Rules and Level 0 Data-Store Mapping"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_212" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#16324F&quot;&gt;Integrity Rules and Level 0 Data-Store Mapping&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2940" height="45" as="geometry"/></mxCell><mxCell id="s_213" value="Logical relational ERD · Crow’s-foot cardinalities · UUID primary keys · immutable submitted versions" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="2940" height="28" as="geometry"/></mxCell><mxCell id="n_208" value="&lt;div style='font-size:19px;font-weight:700;color:#16324F'&gt;Level 0 store → ERD tables&lt;/div&gt;&lt;br&gt;&lt;b&gt;Accounts DB&lt;/b&gt; → UserAccount, Role, Permission, AccountAssignment, UserSession&lt;br&gt;&lt;b&gt;Purok Profile DB&lt;/b&gt; → CDRAProfile + PurokProfile + CDRAProfileVersion and profile child rows&lt;br&gt;&lt;b&gt;Barangay Profile DB&lt;/b&gt; → CDRAProfile + BarangayProfile + BarangayProfileCoverage and child rows&lt;br&gt;&lt;b&gt;Hazards DB&lt;/b&gt; → HazardRecord, HazardVersion, HazardExposure, HazardCapacity, HazardVerification&lt;br&gt;&lt;b&gt;Purok Incident DB&lt;/b&gt; → IncidentReport + PurokIncidentReport + IncidentReportVersion, facts/actions, ReportVerification&lt;br&gt;&lt;b&gt;Barangay Incident DB&lt;/b&gt; → IncidentReport + BarangayIncidentReport + BarangayReportSource, facts/actions, ReportVerification&lt;br&gt;&lt;b&gt;Situation Report DB&lt;/b&gt; → SituationReport, versions, sections, snapshots, decisions, releases, exports&lt;br&gt;&lt;b&gt;Cross-cutting&lt;/b&gt; → InformationSource, Evidence, AuditEvent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1C557E;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="1370" height="700" as="geometry"/></mxCell><mxCell id="n_209" value="&lt;div style='font-size:19px;font-weight:700;color:#16324F'&gt;Required relational constraints&lt;/div&gt;&lt;br&gt;• Foreign-key types exactly match referenced UUID primary keys.&lt;br&gt;• Unique (series_id, version_no) for profile, hazard, report, and SitRep versions.&lt;br&gt;• parent_version_id references an earlier version of the same series.&lt;br&gt;• Submitted/reviewed/verified/approved/released rows are immutable.&lt;br&gt;• Reporting/profile level matches the linked unit type.&lt;br&gt;• Included Purok sources are verified and do not exceed the Barangay cut-off.&lt;br&gt;• SitRep sources are verified and do not exceed the snapshot cut-off.&lt;br&gt;• Returned/rejected decisions require a reason; excluded sources require a reason.&lt;br&gt;• File hashes and audit hashes are retained with the record lifecycle." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#2F855A;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="140" width="1400" height="700" as="geometry"/></mxCell><mxCell id="n_210" value="&lt;div style='font-size:19px;font-weight:700;color:#16324F'&gt;Controlled values: CHECK/ENUM&lt;/div&gt;&lt;br&gt;Use database checks/enums for stable workflow values:&lt;br&gt;• unit_type and reporting_level&lt;br&gt;• account/profile/report/SitRep status&lt;br&gt;• verification stage and decision&lt;br&gt;• report type: Initial, Progress, Terminal&lt;br&gt;• observation_state&lt;br&gt;• confidence_level&lt;br&gt;• privacy_classification&lt;br&gt;• inclusion disposition&lt;br&gt;&lt;br&gt;Use lookup tables only for extensible lists such as hazard type, incident type, damage category, service type, action type, assistance type, need type, asset type, capacity type, age group, and vulnerable-group type." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#B68D2C;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="940" width="1370" height="650" as="geometry"/></mxCell><mxCell id="n_211" value="&lt;div style='font-size:19px;font-weight:700;color:#16324F'&gt;Deliberate exclusions&lt;/div&gt;&lt;br&gt;• No separate history/catalog tables: version and decision tables already preserve history.&lt;br&gt;• No dashboard totals table until measured performance requires a materialized view.&lt;br&gt;• No polymorphic evidence foreign key: use explicit link tables.&lt;br&gt;• No plaintext credentials or credential evidence in business tables.&lt;br&gt;• No person-level casualty/household entity without formal authorization and privacy controls.&lt;br&gt;• No regional/national recipient table unless electronic transmission becomes part of scope.&lt;br&gt;&lt;br&gt;&lt;b&gt;Physical implementation note:&lt;/b&gt; choose PostgreSQL/PostGIS types, indexes, retention, encryption, and row-level security during development; this artifact is the logical ERD." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="940" width="1400" height="650" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
