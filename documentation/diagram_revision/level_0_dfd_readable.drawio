48B;strokeWidth=1.5;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p15_p_122" target="d16_readable"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="audit_p16" value="audit event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p16_p_123" target="d16_readable"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="dictionary" name="Module Dictionary"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2title" value="Module and Data Store Dictionary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2520" height="44" as="geometry"/></mxCell><mxCell id="p2sub" value="The numbering below is the authoritative module boundary for the Level 0 DFD." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2520" height="30" as="geometry"/></mxCell><mxCell id="box_87" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;1.0 Manage Purok Users&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay User creates, assigns, activates, suspends, and resets Purok accounts. No public registration.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_88" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;2.0 Manage Barangay Users&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;DRRM Administrator creates and maintains Barangay accounts, roles, and jurisdiction assignments.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_89" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;3.0 Maintain Purok CDRA Profile&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Purok User maintains versioned local hazard, exposure, vulnerability, capacity, facility, resource, and risk-map data.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_90" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;4.0 Maintain Barangay CDRA Profile&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay User consolidates verified Purok datasets and adds Barangay-level CDRA information.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_91" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;5.0 Create and Maintain Hazard Record&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Purok, Barangay, and DRRM users create jurisdiction-scoped hazard versions with evidence.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="805" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_92" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;6.0 Verify Purok CDRA Profile&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay User accepts, returns, or rejects a particular Purok profile version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_93" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;7.0 Verify Barangay CDRA Profile&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;DRRM Administrator accepts, returns, or rejects a particular Barangay profile version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1145" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_94" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;8.0 Submit Purok Incident Report&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Purok User submits preliminary and corrected incident report versions.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1315" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_95" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;9.0 Verify Purok Incident Report&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay User reviews evidence and records a version-specific decision or correction request.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1485" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_96" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;10.0 Consolidate and Submit Barangay Incident Report&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay User consolidates eligible verified Purok reports and Barangay-level facts.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="125" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_97" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;11.0 Verify Barangay Incident Report&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;DRRM Administrator verifies and reconciles Barangay report versions and their sources.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="295" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_98" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;12.0 Generate, Review, and Approve Situation Report&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;DRRM assembles an as-of source snapshot, produces narrative/tables, records review and approval, and exports.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="465" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_99" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;13.0 Browse Purok Incident Report History&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Authorized Purok User retrieves retained Purok report versions and statuses.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="635" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_100" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;14.0 Browse Barangay Incident Report History&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Authorized Barangay User retrieves retained Barangay report versions and statuses.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="805" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_101" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;15.0 Browse Situation Report Historical Catalog&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Authorized DRRM user retrieves prior Situation Report versions, approvals, and exports.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="975" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_102" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;16.0 View Platform Dashboard&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Authorized users view jurisdiction-scoped maps, totals, trends, statuses, and source links.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="1145" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_103" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;17.0 Authenticate and Authorize Access&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Validates credentials and enforces account, role, organization, jurisdiction, and record-state permissions.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="1315" width="1190" height="145" as="geometry"/></mxCell><mxCell id="box_104" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;18.0 Verify Hazard Record by Level&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Barangay verifies Purok hazards; DRRM verifies Barangay hazards; City-authored records require a distinct authorized DRRM verifier.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="1485" width="1190" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="evidence" name="Data &amp; Evidence"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3title" value="Data Packages, Stores, and Evidence Basis" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2520" height="44" as="geometry"/></mxCell><mxCell id="box_105" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Purok CDRA profile package&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Geography; climate projection/scenario; hazard inventory, location, intensity, frequency/probability; historical loss/damage; exposed population and assets; urban-use and natural-resource production areas; critical facilities; lifeline utilities; sensitivity/vulnerability; adaptive/coping capacity; risk score/map; source and version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_106" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Verified Purok profile dataset&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;The accepted Purok profile version, verification decision, reviewer, reason, timestamp, unresolved limitations, and provenance links. This is an input to Barangay profiling.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="120" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_107" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Barangay CDRA additions and consolidation&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Included verified Purok versions; Barangay-wide datasets; cross-Purok facilities/resources; aggregation rules; discrepancies; Barangay source, as-of time, and profile version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_108" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Hazard proposal / verification package&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Jurisdiction and geometry; hazard type and characteristics; likelihood/frequency; intensity/severity; affected/exposed areas; source evidence; author; version; reviewer decision, reason, correction request, and timestamp.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="365" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_109" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Purok incident report package&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Incident reference/type; exact geography; occurrence/discovery/report times; source; chronology; affected population; evacuation; casualties; damaged houses/infrastructure/agriculture/livelihood; service disruption; actions; assistance/resources; needs/issues; attachments; as-of time.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_110" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Barangay incident consolidation package&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Included verified Purok versions; excluded/returned items and reasons; consolidated impact/action figures; Barangay-level facts; unresolved discrepancies; source set; as-of time; immutable report version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="610" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_111" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Situation Report source snapshot&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Only eligible verified report versions at a fixed cut-off; chronology and prevailing situation; affected population/displacement/evacuation; casualties; damage/loss; related incidents; actions; assistance/resources; service status; issues/needs; recommendations; provenance and unresolved discrepancies.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="855" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_112" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Situation Report output&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;Report number/type/version; as-of time and operational period; narrative; cumulative tables; source summary; corrections; reviewer/approver; approval/release time; export/publication status.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FFFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="855" width="1200" height="215" as="geometry"/></mxCell><mxCell id="box_113" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data stores D1–D8&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;D1 Purok User Accounts&lt;br&gt;D2 Barangay User Accounts&lt;br&gt;D3 Roles and Jurisdictions&lt;br&gt;D4 Purok CDRA Profile Versions&lt;br&gt;D5 Barangay CDRA Profile Versions&lt;br&gt;D6 Purok Profile Verification Decisions&lt;br&gt;D7 Barangay Profile Verification Decisions&lt;br&gt;D8 Hazard Record Versions&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="760" height="360" as="geometry"/></mxCell><mxCell id="box_114" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Data stores D9–D16&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;D9 Hazard Verification Decisions&lt;br&gt;D10 Purok Incident Report Versions&lt;br&gt;D11 Purok Incident Verification Decisions&lt;br&gt;D12 Barangay Incident Report Versions&lt;br&gt;D13 Barangay Incident Verification Decisions&lt;br&gt;D14 Situation Report Versions and Approvals&lt;br&gt;D15 Attachments and Source Evidence&lt;br&gt;D16 Audit Events&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="880" y="1120" width="760" height="360" as="geometry"/></mxCell><mxCell id="box_115" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Mandate and evidence basis&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;RA 10121 §§3 and 12: disaster impacts, risk assessment/mapping, local hazard/vulnerability/climate-risk information, resources, equipment, directories, and critical infrastructure.&lt;br&gt;&lt;br&gt;DHSUD CDRA guidance: hazard characterization, climate scenarios, exposure database, sensitivity/vulnerability, adaptive capacity, maps, and risk scores.&lt;br&gt;&lt;br&gt;NDRRMOC SOPG 2024 pp. 52–55, 63 and published NDRRMC SitReps: initial/progress/terminal/final reporting; current developments/actions; supporting sources; cumulative impacts; issues and recommendations.&lt;br&gt;&lt;br&gt;Project interview: narrative/chronology, variable operational periods, first- and second-hand sources, retained versions, verification, privacy sanitization, and approval.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1700" y="1120" width="820" height="500" as="geometry"/></mxCell><mxCell id="box_116" value="&lt;div style='font-size:17px;font-weight:700;color:#16324F;margin-bottom:8px'&gt;Primary references&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.45;color:#1F2937'&gt;https://lawphil.net/statutes/repacts/ra2010/ra_10121_2010.html&lt;br&gt;&lt;br&gt;https://www.dhsud.gov.ph/wp-content/uploads/Publication/CDRA/CDRA_Briefer_USAID-SURGE&amp;DHSUD.pdf&lt;br&gt;&lt;br&gt;https://ndrrmc.gov.ph/attachments/article/4125/NDRRMOC_SOPG_2024_EDITION.pdf&lt;br&gt;&lt;br&gt;documentation/transcripts/CAPSTONE-INTERVIEW TRANSCRIPTS.md&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="1580" height="300" as="geometry"/></mxCell><mxCell id="note_117" value="Design note: mandates define information and reporting duties, but they do not prescribe this exact software database schema or literal Purok-to-Barangay routing. The module split follows the study’s confirmed actors, adviser convention, and local interview evidence." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B48A00;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="1645" width="820" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
